# Application Environment Variables
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*

# PostgreSQL Database Connection URL (Prisma ORM)
DATABASE_URL="postgresql://user:password@localhost:5432/esg_report?schema=public"

# Local evidence PDF storage (created automatically)
ESG_UPLOAD_DIR=./uploads/evidence

# Authentication (set unique values before starting the API)
JWT_SECRET=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Logging configuration (error | warn | info | http | debug)
LOG_LEVEL=debug

# Cloudinary Integration (Images & PDFs)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
